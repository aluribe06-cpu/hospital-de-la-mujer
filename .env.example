# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA DE FARMACIA HOSPITAL DE LA MUJER
# SERVICIOS DE SALUD IMSS-BIENESTAR (TEPIC, NAYARIT)
# ==============================================================================

# Entorno de Ejecución
NODE_ENV=production
PORT=8080

# Base de Datos SQL (PostgreSQL / Supabase / Google Cloud SQL)
DATABASE_URL=postgresql://imss_admin:hospital_mujer_secret_pass_2026@localhost:5432/hospital_mujer_farmacia?schema=public
DIRECT_URL=postgresql://imss_admin:hospital_mujer_secret_pass_2026@localhost:5432/hospital_mujer_farmacia

# Autenticación y Seguridad
JWT_SECRET=super_secret_jwt_key_hospital_mujer_imss_bienestar_2026_nayarit
SESSION_EXPIRY_HOURS=12

# Almacenamiento de Archivos (Supabase / AWS S3)
STORAGE_BUCKET_NAME=expedientes-farmacia-hospital-mujer
STORAGE_ACCESS_KEY_ID=tu_access_key_aqui
STORAGE_SECRET_ACCESS_KEY=tu_secret_key_aqui

# Notificaciones y Alertas Automáticas (Resend / SendGrid / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=farmacia.hospitalmujer@imssbienestar.gob.mx
SMTP_PASS=tu_password_de_aplicacion
EMAIL_NOTIFICACIONES_QFB=responsable.farmacia@imssbienestar.gob.mx

# Despliegue en Vercel
VERCEL_ORG_ID=tu_org_id_vercel
VERCEL_PROJECT_ID=tu_project_id_vercel
